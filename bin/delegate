#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'HELP'
Usage: delegate run <prompt.md> [--agent NAME] [--dir DIR] [--check CMD]
                    [--max-summary N] [--timeout SEC]
       delegate auto <prompt.md> [any run option] [--rounds N] [--no-review]
Agents: codex (default), claude-compat, custom. Summary limit: 4000 bytes.
Timeout: positive integer seconds for the agent and check together.
Auto: at most 3 worker runs by default, then read-only review; --no-review skips it.
DELEGATE_REVIEW_MODEL / DELEGATE_REVIEW_EFFORT override the Codex reviewer.
See README.md for environment variables and permissions.
HELP
}
fail() { printf 'delegate: %s\n' "$*" >&2; exit 2; }

if [[ ${1:-} == --help || ${1:-} == -h ]]; then usage; exit 0; fi
mode=${1:-}
[[ $mode == run || $mode == auto ]] || fail 'expected run or auto; use --help for usage'
shift
run_started=$(python3 -c 'import time; print(time.monotonic())')
[[ $# -gt 0 ]] || fail 'missing prompt file'
prompt=$1
shift
agent=codex
dir=.
check=
max_summary=4000
timeout=0
rounds=3
review=true
check_given=false
run_options=()
while [[ $# -gt 0 ]]; do
    if [[ $mode == auto && $1 == --no-review ]]; then review=false; shift; continue; fi
    [[ $# -ge 2 ]] || fail "missing value for $1"
    case $1 in
        --agent) agent=$2 ;;
        --dir) dir=$2 ;;
        --check) check=$2; check_given=true ;;
        --max-summary) max_summary=$2 ;;
        --timeout)
            [[ $2 =~ ^[0-9]+$ && $2 =~ [1-9] ]] || fail 'timeout must be positive integer seconds'
            timeout=$2 ;;
        --rounds)
            [[ $mode == auto ]] || fail "unknown option: $1"
            [[ $2 =~ ^[0-9]+$ && $2 =~ [1-9] ]] || fail 'rounds must be a positive integer'
            rounds=$2; shift 2; continue ;;
        *) fail "unknown option: $1" ;;
    esac
    run_options+=("$1" "$2")
    shift 2
done
[[ $max_summary =~ ^[0-9]+$ ]] || fail 'max-summary must be a nonnegative byte count'
[[ -f $prompt && -r $prompt ]] || fail 'prompt must be a readable file'
prompt=$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$prompt")
dir=$(cd -- "$dir" && pwd -P) || fail 'target directory does not exist'
if [[ $mode == auto ]]; then
    # The array guard supports Bash 3.2's nounset when no run options were supplied.
    exec python3 - "$0" "$prompt" "$dir" "$rounds" "$review" "$check_given" "$agent" "$timeout" ${run_options[@]+"${run_options[@]}"} <<'AUTO_PY'
import datetime
import os
from pathlib import Path
import re
import subprocess
import sys

script, prompt, directory, rounds, review, check_given, agent, timeout = sys.argv[1:9]
script = str(Path(script).resolve())
brief = Path(prompt).read_bytes()
options = sys.argv[9:]
in_git = subprocess.run(['git', '-C', directory, 'rev-parse', '--is-inside-work-tree'],
                        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.strip() == b'true'
dirty = subprocess.check_output(['git', '-C', directory, '-c', 'color.status=false',
                                 'status', '--short']) if in_git else b''
base = Path(directory, '.delegate')
base.mkdir(exist_ok=True)
stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
task = Path(subprocess.check_output(['mktemp', '-d', str(base / f'auto-{stamp}-XXXXXX')])
            .decode().rstrip('\n'))
(task / 'dirty-before.txt').write_bytes(dirty)

def invoke(name, contents, args, env=None):
    source = task / f'{name}.prompt.md'
    source.write_bytes(contents)
    with (task / f'{name}.txt').open('wb') as output, (task / f'{name}.err').open('wb') as errors:
        status = subprocess.run([script, 'run', str(source), *args], stdout=output,
                                stderr=errors, env=env).returncode
    output = (task / f'{name}.txt').read_bytes()
    # Usage failures have no run report; a worker/check exiting 2 does have one.
    if status == 2 and not output.startswith(b'out.md (first '):
        sys.stderr.buffer.write((task / f'{name}.err').read_bytes())
        sys.exit(2)
    return status, output

def sections(output):
    _, header, body = output.partition(b' bytes):\n')
    message, boundary, rest = body.partition(b'\ngit status --short (first 30 lines):\n')
    if not header or not boundary:
        return b'', None, b''
    check = re.search(rb'^check exit code: (\d+|not run)\n', rest, re.M)
    if not check:
        return message, None, b''
    tail = rest[check.end():].rpartition(b'elapsed: ')[0]
    return message, check[1], b''.join(tail.splitlines(keepends=True)[-40:])

review_env = os.environ.copy()
review_env['DELEGATE_CODEX_SANDBOX'] = 'read-only'
for key in ('MODEL', 'EFFORT'):
    if os.environ.get(f'DELEGATE_REVIEW_{key}'):
        review_env[f'DELEGATE_CODEX_{key}'] = os.environ[f'DELEGATE_REVIEW_{key}']
review_options = ['--agent', agent, '--dir', directory, '--max-summary', '3000']
if timeout != '0':
    review_options += ['--timeout', timeout]
review_prompt = (b'# delegate auto review\n\n'
    b'Review the current working tree. Do NOT modify anything, including tests or gates.\n'
    b'Run `git status --short` and `git diff` yourself, and read untracked files yourself.\n'
    b'Check every acceptance item in the brief. Look for corner-cutting: fewer tests than\n'
    b'required, stubbed logic, edited gates/tests to pass, and files outside scope.\n\n'
    b'## Original brief\n' + brief + b'\n\n'
    + ((b'## Check already passed outside your sandbox\n`' + options[options.index('--check') + 1].encode()
        + b'` exited 0. Do not re-run builds, dev servers or browsers: your sandbox cannot run them,\n'
        b'so a crash there is not a finding. FAIL only for unmet acceptance items in the brief or real\n'
        b'defects in the diff; things the brief did not ask for go in the PASS notes.\n\n')
       if '--check' in options else b'')
    + b'## Pre-existing dirty files\n'
    b'ignore these unless the brief is about them:\n' + (dirty or b'(none)\n') + b'\n'
    b'## Required final message\n'
    b'Line 1 must be exactly `VERDICT: PASS` or `VERDICT: FAIL`.\n'
    b'Then at most 12 lines `path:line \xe2\x80\x94 problem`. On FAIL, list blocking problems.\n'
    b'On PASS, list at most 5 spots most worth a human glance.\n')
reason = b''
last_review = None
passed = False
for number in range(1, int(rounds) + 1):
    contents = brief
    if number > 1:
        contents += (f'\n\n## Round {number}: your previous attempt was rejected\n\n'.encode()
                     + reason + b'\n\nYour previous changes are still in the working tree; '
                     b'fix them in place, do not start over.\n')
    status, output = invoke(f'round-{number}', contents, options)
    message, check_status, check_tail = sections(output)
    green = check_status == b'0' or (check_given == 'false' and status == 0)
    if not green:
        failure = (f'check exit code: {check_status.decode()}' if check_status not in (None, b'not run')
                   else f'worker exited with status {status}')
        reason = failure.encode() + b'\n' + (check_tail if check_given == 'true' else message)
        last_review = None  # an earlier round's review no longer describes this tree
        continue
    if review == 'false':
        passed = True
        break
    _, review_output = invoke(f'review-{number}', review_prompt, review_options, review_env)
    last_review, _, _ = sections(review_output)
    verdict = re.search(rb'^VERDICT: (PASS|FAIL)\r?$', last_review, re.M)
    if verdict and verdict[1] == b'PASS':
        passed = True
        break
    failure = 'review rejected changes' if verdict else 'reviewer gave no verdict'
    reason = last_review if verdict else b'reviewer gave no verdict\n' + last_review

result = 'PASS' if passed else 'FAIL'
detail = b'' if passed else b' (' + ' '.join(failure.split()).encode()[:160] + b')'
header = (f'auto: {result} after {number} round(s)'.encode() + detail
          + f'; files: .delegate/{task.name}/\n'.encode())
review_report = b'\nreview:\n' + last_review[:2000] + b'\n' if last_review is not None else b''
# Preserve short run reports verbatim; full reports remain on disk when the budget is exceeded.
budget = 4096 - len(header) - len(review_report)
if len(output) > budget:
    notice = f'\n[truncated; see round-{number}.txt]\n'.encode()
    output = output[:budget - len(notice)] + notice
sys.stdout.buffer.write(header + output + review_report)
sys.exit(0 if passed else 1)
AUTO_PY
fi
in_git=false
if [[ $(git -C "$dir" rev-parse --is-inside-work-tree 2>/dev/null || true) == true ]]; then
    in_git=true
    exclude=$(git -C "$dir" rev-parse --git-path info/exclude)
    [[ $exclude == /* ]] || exclude="$dir/$exclude"
    python3 - "$exclude" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
path.parent.mkdir(parents=True, exist_ok=True)
text = path.read_text() if path.exists() else ''
if '.delegate/' not in text.splitlines():
    with path.open('a') as stream:
        stream.write(('\n' if text and not text.endswith('\n') else '') + '.delegate/\n')
PY
fi
mkdir -p "$dir/.delegate"
run=$(mktemp -d "$dir/.delegate/$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX")
cp -- "$prompt" "$run/prompt.md"
export DELEGATE_OUT="$run/out.md"
: > "$DELEGATE_OUT"
: > "$run/run.log"

case $agent in
    codex)
        # DELEGATE_CODEX_SANDBOX=danger-full-access：只给必须起浏览器 / 模拟器的任务（macOS 沙箱会拦 Chrome 的 bootstrap_check_in）
        cmd=("${DELEGATE_CODEX_BIN:-codex}" exec -C "$dir" -s "${DELEGATE_CODEX_SANDBOX:-workspace-write}" -o "$DELEGATE_OUT")
        [[ $in_git == true ]] || cmd+=(--skip-git-repo-check)
        [[ -z ${DELEGATE_CODEX_MODEL:-} ]] || cmd+=(-m "$DELEGATE_CODEX_MODEL")
        [[ -z ${DELEGATE_CODEX_EFFORT:-} ]] || cmd+=(-c "model_reasoning_effort=$DELEGATE_CODEX_EFFORT")
        if [[ ${DELEGATE_CODEX_NETWORK:-0} == 1 ]]; then
            cmd+=(-c sandbox_workspace_write.network_access=true)
        else
            cmd+=(-c sandbox_workspace_write.network_access=false)
        fi
        # 额外可写目录（空格分隔），例如 worktree 里软链到主目录的 node_modules（vite 要写 .vite 缓存）
        for extra in ${DELEGATE_CODEX_ADD_DIRS:-}; do cmd+=(--add-dir "$extra"); done
        cmd+=(-) ;;
    claude-compat)
        [[ -n ${DELEGATE_COMPAT_BASE_URL:-} && -n ${DELEGATE_COMPAT_MODEL:-} ]] || fail 'set DELEGATE_COMPAT_BASE_URL and DELEGATE_COMPAT_MODEL'
        token_env=${DELEGATE_COMPAT_TOKEN_ENV:-}
        [[ $token_env =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || fail 'DELEGATE_COMPAT_TOKEN_ENV must name a token environment variable'
        [[ -n ${!token_env:-} ]] || fail 'the named token variable is empty'
        # Save before env -u, even when the source variable is ANTHROPIC_API_KEY.
        export DELEGATE_COMPAT_SECRET="${!token_env}"
        cmd=(env)
        while IFS= read -r key; do cmd+=(-u "$key"); done < <(python3 - <<'PY'
import os
for key in os.environ:
    if key.startswith('ANTHROPIC_') or key in {
        'CLAUDECODE', 'CLAUDE_CODE_OAUTH_TOKEN', 'CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR',
        'CLAUDE_CODE_SUBAGENT_MODEL',
        'CLAUDE_CODE_USE_BEDROCK', 'CLAUDE_CODE_USE_VERTEX', 'CLAUDE_CODE_USE_FOUNDRY',
    }:
        print(key)
PY
        )
        cmd+=(bash -c '
            export ANTHROPIC_BASE_URL="$DELEGATE_COMPAT_BASE_URL"
            export ANTHROPIC_AUTH_TOKEN="$DELEGATE_COMPAT_SECRET"
            export ANTHROPIC_MODEL="$DELEGATE_COMPAT_MODEL"
            export ANTHROPIC_DEFAULT_OPUS_MODEL="$DELEGATE_COMPAT_MODEL"
            export ANTHROPIC_DEFAULT_SONNET_MODEL="$DELEGATE_COMPAT_MODEL"
            export ANTHROPIC_DEFAULT_HAIKU_MODEL="$DELEGATE_COMPAT_MODEL"
            export ANTHROPIC_DEFAULT_FABLE_MODEL="$DELEGATE_COMPAT_MODEL"
            unset DELEGATE_COMPAT_SECRET
            exec claude -p --model "$DELEGATE_COMPAT_MODEL" --output-format json --permission-mode acceptEdits
        ') ;;
    custom)
        [[ -n ${DELEGATE_CMD:-} ]] || fail 'set DELEGATE_CMD for custom'
        cmd=(bash -c "$DELEGATE_CMD") ;;
    *) fail "unknown agent: $agent" ;;
esac

exec python3 - "$dir" "$run" "$agent" "$check" "$max_summary" "$timeout" "$in_git" "$run_started" "${cmd[@]}" <<'PY'
import collections
import datetime
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time

directory, run, agent, check, limit, timeout, in_git = sys.argv[1:8]
run = Path(run)
started = float(sys.argv[8])
deadline = started + int(timeout) if int(timeout) else None
log = (run / 'run.log').open('ab', buffering=0)

def interrupt(signum, frame):
    raise KeyboardInterrupt

signal.signal(signal.SIGTERM, interrupt)

def execute(command, output, source=None):
    remaining = deadline - time.monotonic() if deadline else None
    if remaining is not None and remaining <= 0:
        output.write(b'delegate: timeout before command started\n')
        return 124
    try:
        process = subprocess.Popen(command, cwd=directory, stdin=source or subprocess.DEVNULL,
                                   stdout=output, stderr=subprocess.STDOUT, start_new_session=True)
    except OSError as error:
        output.write(f'delegate: {error}\n'.encode())
        return 127
    try:
        status = process.wait(timeout=remaining)
        return status if status >= 0 else 128 - status
    except (subprocess.TimeoutExpired, KeyboardInterrupt) as error:
        # Kill the group, including grandchildren that keep log files open.
        try:
            os.killpg(process.pid, signal.SIGTERM)
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                pass
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()
        status = 124 if isinstance(error, subprocess.TimeoutExpired) else 130
        output.write(f'delegate: command stopped (exit {status})\n'.encode())
        return status

# Codex account rotation: DELEGATE_CODEX_HOMES lists CODEX_HOME dirs, each logged in
# separately. The state file is one line, "home=reset_epoch ...", recording only
# exhausted accounts. Ready accounts go first in configured order, then exhausted
# ones by soonest reset; on a usage-limit error the next account reruns the prompt.
homes = os.environ.get('DELEGATE_CODEX_HOMES', '').split() if agent == 'codex' else []
state = Path(os.environ.get('DELEGATE_CODEX_STATE') or Path.home() / '.delegate-codex-state')
# Real wording seen 2026-10-08: "ERROR: You’ve hit your usage limit. ... try again at
# Oct 9th, 2026 4:16 AM." The binary also has "reached your usage limit". Anchoring on
# ERROR: skips the prompt that codex exec echoes into the log.
LIMIT = re.compile(rb'^ERROR: .*your usage limit.*$', re.M)
# 2026-10-10: both accounts said "try again at 4:10 AM." (time only, no date), but the
# newest rollout snapshot of ~/.codex still had resets_at 03:15, already stale. The
# state file trusted 03:15, a job scheduled at 03:20 died in 37s and the night was
# lost. So the error line is the authority; rollout snapshots are only a fallback.
AGAIN = re.compile(r'try again at (.+?)\.?\s*$')

def parse_reset(line, now=None):
    # "Oct 9th, 2026 4:16 AM" or "4:10 AM" (today, or tomorrow if already past).
    # None when the wording is unknown or the time is not in the future.
    now = now or time.time()
    match = AGAIN.search(line)
    if not match:
        return None
    when = re.sub(r'(\d)(st|nd|rd|th),', r'\1,', ' '.join(match.group(1).split()))
    for fmt in ('%b %d, %Y %I:%M %p', '%I:%M %p'):
        try:
            parsed = datetime.datetime.strptime(when, fmt)
        except ValueError:
            continue
        if fmt == '%I:%M %p':
            parsed = datetime.datetime.fromtimestamp(now).replace(
                hour=parsed.hour, minute=parsed.minute, second=0, microsecond=0)
            if parsed.timestamp() <= now:
                parsed += datetime.timedelta(days=1)
        return parsed.timestamp() if parsed.timestamp() > now else None
    return None

def load_state():
    try:
        return {h: float(e) for h, e in (p.rsplit('=', 1) for p in state.read_text().split())}
    except (OSError, ValueError):
        return {}

def reset_epoch(home):
    # Codex logs rate_limits snapshots (with resets_at) into its rollout files. Pick
    # the window with the highest used_percent: the error itself may come before a
    # fresh snapshot, but the nearly-full window is the one that ran out.
    for day in (0, 86400):
        folder = Path(home, 'sessions', time.strftime('%Y/%m/%d', time.localtime(time.time() - day)))
        for rollout in sorted(folder.glob('rollout-*.jsonl'), key=lambda p: p.stat().st_mtime, reverse=True):
            for line in reversed(rollout.read_bytes().splitlines()):
                if b'"rate_limits"' not in line:
                    continue
                try:
                    limits = json.loads(line)['payload']['rate_limits']
                    # Skip windows that already reset: that snapshot predates the limit.
                    windows = [w for w in (limits.get('primary'), limits.get('secondary'))
                               if w and float(w['resets_at']) > time.time()]
                    if not windows:
                        continue
                    return float(max(windows, key=lambda w: w['used_percent'])['resets_at'])
                except (ValueError, KeyError, TypeError):
                    continue
    return time.time() + 3600  # ponytail: unknown format, assume an hour

if homes:
    exhausted = {h: e for h, e in load_state().items() if e > time.time()}
    homes.sort(key=lambda h: exhausted.get(h, 0))
for home in homes or [None]:
    if home:
        os.environ['CODEX_HOME'] = os.path.expanduser(home)
    start = (run / 'run.log').stat().st_size
    with (run / 'prompt.md').open('rb') as source:
        agent_status = execute(sys.argv[9:], log, source)
    if not home:
        break
    with (run / 'run.log').open('rb') as stream:
        stream.seek(start)
        hit = LIMIT.search(stream.read())
    if not hit:
        exhausted.pop(home, None)
        break
    exhausted[home] = (parse_reset(hit.group().decode(errors='replace'))
                       or reset_epoch(os.environ['CODEX_HOME']))
    until = time.strftime('%m-%d %H:%M', time.localtime(exhausted[home]))
    print(f'delegate: {home} out of quota until {until}', file=sys.stderr)
if homes:
    state.write_text(' '.join(f'{h}={int(e)}' for h, e in exhausted.items()) + '\n')
os.environ.pop('DELEGATE_COMPAT_SECRET', None)
out = run / 'out.md'
if agent == 'claude-compat' and agent_status == 0:
    result = None
    with (run / 'run.log').open('rb') as stream:
        for line in stream:
            try:
                record = json.loads(line)
            except (ValueError, UnicodeDecodeError):
                continue
            if isinstance(record, dict) and record.get('type') == 'result':
                result = record
    if result and isinstance(result.get('result'), str):
        out.write_text(result['result'], encoding='utf-8')
        if result.get('is_error'):
            agent_status = 1
    else:
        agent_status = 1
        log.write(b'delegate: no Claude JSON result found\n')
if not out.is_file() or out.stat().st_size == 0:
    agent_status = agent_status or 1
    log.write(b'delegate: missing or empty final message\n')

check_status = 0
if check:
    with (run / 'check.log').open('wb', buffering=0) as stream:
        check_status = execute(['bash', '-c', check], stream)
stdout = sys.stdout.buffer
stdout.write(f'out.md (first {limit} bytes):\n'.encode())
if out.is_file():
    with out.open('rb') as stream:
        stdout.write(stream.read(int(limit)))
stdout.write(b'\ngit status --short (first 30 lines):\n')
if in_git == 'true':
    with (run / 'status.log').open('wb') as stream:
        status = subprocess.run(['git', '-c', 'color.status=false', 'status', '--short'],
                                cwd=directory, stdout=stream, stderr=log).returncode
    if status:
        agent_status = agent_status or status
    with (run / 'status.log').open('rb') as stream:
        for index, line in enumerate(stream):
            if index == 30:
                break
            stdout.write(line)
if check:
    stdout.write(f'check exit code: {check_status}\n'.encode())
    with (run / 'check.log').open('rb') as stream:
        stdout.writelines(collections.deque(stream, maxlen=20))
    stdout.write(b'\n')
else:
    stdout.write(b'check exit code: not run\n')
stdout.write(f'elapsed: {time.monotonic() - started:.2f}s\n'.encode())
stdout.flush()
if agent_status:
    print(f'delegate: agent/run exit {agent_status}; see .delegate/{run.name}/run.log', file=sys.stderr)
sys.exit(agent_status or check_status)
PY
